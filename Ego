local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local MessagingService = game:GetService("MessagingService")
local DataStoreService = game:GetService("DataStoreService")

local BanStore = DataStoreService:GetDataStore("EGO_BANS_V3")
local TitleStore = DataStoreService:GetDataStore("EGO_TITLES_V3")

local GLOBAL_TOPIC = "EGO_GLOBAL_V3"

--========================================================
-- TITLES
--========================================================

local TITLES = {
	"creator",
	"owner",
	"disbander",
	"admin",
	"staff",
	"hacker",
	"दानव",
	"खलनायक",
	"aukat ke bahar",
	"hunter",
	"gojo",
	"Sukuna",
	"og",
	"daddy",
	"her",
	"his",
	"architect",
	"badnam",
}

local TITLE_LOOKUP = {}

for _, title in ipairs(TITLES) do
	TITLE_LOOKUP[string.lower(title)] = title
end

local function isCreator(player)
	return player.UserId == game.CreatorId
end

local function getTitle(player)
	return player:GetAttribute("EGO_Title") or ""
end

--========================================================
-- CHAT DISPLAY
--========================================================

local function getGeneralChannel()
	return TextChatService.TextChannels:FindFirstChild("RBXGeneral")
end

local function display(text)
	local channel = getGeneralChannel()

	if channel then
		channel:DisplaySystemMessage(text)
	end
end

--========================================================
-- CREATE COMMAND
--========================================================

local function createCommand(name, alias, secondAlias)
	local command = Instance.new("TextChatCommand")
	command.Name = name
	command.PrimaryAlias = alias

	if secondAlias then
		command.SecondaryAlias = secondAlias
	end

	command.Parent = TextChatService

	return command
end

--========================================================
-- SERVER CHAT
-- /server message
-- /s message
--========================================================

local ServerCommand = createCommand(
	"EGO_ServerChat",
	"/server",
	"/s"
)

ServerCommand.Triggered:Connect(function(source, rawText)

	local player = Players:GetPlayerByUserId(source.UserId)
	if not player then return end

	local message = rawText:gsub("^%S+%s*", "", 1)

	if message == "" then return end

	display(
		"<font color='#00BFFF'><b>[SERVER]</b></font> " ..
		"<font color='#FFD700'>[" .. getTitle(player) .. "]</font> " ..
		"<b>" .. player.DisplayName .. ":</b> " ..
		message
	)
end)

--========================================================
-- GLOBAL CHAT
-- /global message
-- /g message
--========================================================

local GlobalCommand = createCommand(
	"EGO_GlobalChat",
	"/global",
	"/g"
)

GlobalCommand.Triggered:Connect(function(source, rawText)

	local player = Players:GetPlayerByUserId(source.UserId)
	if not player then return end

	local message = rawText:gsub("^%S+%s*", "", 1)

	if message == "" then return end

	local data = {
		Type = "CHAT",
		Name = player.DisplayName,
		Title = getTitle(player),
		Message = message
	}

	pcall(function()
		MessagingService:PublishAsync(GLOBAL_TOPIC, data)
	end)
end)

--========================================================
-- GLOBAL MESSAGE RECEIVER
--========================================================

pcall(function()

	MessagingService:SubscribeAsync(
		GLOBAL_TOPIC,
		function(packet)

			local data = packet.Data

			if typeof(data) ~= "table" then
				return
			end

			if data.Type == "CHAT" then

				display(
					"<font color='#FF4444'><b>[GLOBAL]</b></font> " ..
					"<font color='#FFD700'>[" ..
					(data.Title or "") ..
					"]</font> " ..
					"<b>" ..
					(data.Name or "Player") ..
					":</b> " ..
					(data.Message or "")
				)

			elseif data.Type == "ANNOUNCEMENT" then

				display(
					"<font color='#FF4444'><b>🌎 GLOBAL ANNOUNCEMENT</b></font>\n" ..
					"<font color='#FFFFFF'>" ..
					(data.Message or "") ..
					"</font>"
				)
			end
		end
	)

end)

