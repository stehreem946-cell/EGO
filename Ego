--========================================================
-- GLOBAL ANNOUNCEMENT
-- /gannounce message
-- /gann message
-- CREATOR ONLY
--========================================================

local GlobalAnnouncementCommand = createCommand(
	"EGO_GlobalAnnouncement",
	"/gannounce",
	"/gann"
)

GlobalAnnouncementCommand.Triggered:Connect(function(source, rawText)

	local player = Players:GetPlayerByUserId(source.UserId)

	if not player or not isCreator(player) then
