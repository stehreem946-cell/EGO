--========================================================
-- GIVE TITLE
-- /title PlayerName Title
-- CREATOR ONLY
--========================================================

local TitleCommand = createCommand(
	"EGO_Title",
	"/title"
)

TitleCommand.Triggered:Connect(function(source, rawText)

	local creator = Players:GetPlayerByUserId(source.UserId)

	-- ONLY CREATOR
	if not creator or not isCreator(creator) then
		return
	end

	local args = string.split(rawText, " ")

	-- /title PlayerName Title
	if #args < 3 then
		display(
			"<font color='#FF5555'>Usage: /title PlayerName Title</font>"
		)
		return
	end

	table.remove(args, 1)

	local targetName = args[1]
	table.remove(args, 1)

	local requestedTitle = table.concat(args, " ")

	local targetTitle =
		TITLE_LOOKUP[string.lower(requestedTitle)]

	if not targetTitle then
		display(
			"<font color='#FF5555'>Invalid EGO title.</font>"
		)
		return
	end

	local targetPlayer

	for _, player in ipairs(Players:GetPlayers()) do
		if string.lower(player.Name) == string.lower(targetName)
			or string.lower(player.DisplayName) == string.lower(targetName) then

			targetPlayer = player
			break
		end
	end

	if not targetPlayer then
		display(
			"<font color='#FF5555'>Player not found.</font>"
		)
		return
	end

	targetPlayer:SetAttribute("EGO_Title", targetTitle)

	pcall(function()
		TitleStore:SetAsync(
			tostring(targetPlayer.UserId),
			targetTitle
		)
	end)

	display(
		"<font color='#FFD700'><b>[EGO]</b></font> " ..
		"Title <b>" .. targetTitle .. "</b> given to " ..
		"<b>" .. targetPlayer.DisplayName .. "</b>."
	)
end)

--========================================================
-- REMOVE TITLE
-- /removetitle PlayerName
-- CREATOR ONLY
--========================================================

local RemoveTitleCommand = createCommand(
	"EGO_RemoveTitle",
	"/removetitle"
)

RemoveTitleCommand.Triggered:Connect(function(source, rawText)

	local creator = Players:GetPlayerByUserId(source.UserId)

	if not creator or not isCreator(creator) then
		return
	end

	local targetName = rawText:gsub("^%S+%s*", "", 1)

	if targetName == "" then return end

	for _, player in ipairs(Players:GetPlayers()) do

		if string.lower(player.Name) == string.lower(targetName)
			or string.lower(player.DisplayName) == string.lower(targetName) then

			player:SetAttribute("EGO_Title", "")

			pcall(function()
				TitleStore:RemoveAsync(
					tostring(player.UserId)
				)
			end)

			display(
				"<font color='#FFD700'><b>[EGO]</b></font> Title removed from " ..
				player.DisplayName
			)

			return
		end
	end
end)

